# Meta Instagram Webhook (developers.facebook.com → 3. Webhooks 구성)
# 「인증 토큰」= 직접 정한 비밀 문자열. 아래 값을 대시보드에 그대로 입력할 것.
# ※ 「토큰 생성」으로 받는 IGAA... 액세스 토큰과는 다름
META_VERIFY_TOKEN=

# 이용 사례 → 「토큰 생성」버튼으로 받은 액세스 토큰 (Graph API / DM 발송)
INSTAGRAM_ACCESS_TOKEN=

# Instagram 개발자 이용 사례에 등록된 비즈니스 계정 ID (숫자)
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Webhook 수신 바디 전체 로그 (디버그 시만 1)
# INSTAGRAM_WEBHOOK_DEBUG=1

# Message pass purchases (register two consumable products in the Toss console)
# Keep false until BOTH products are registered, exposed, and device-tested.
MESSAGE_PASSES_ENABLED=false
TOSS_MESSAGE_PASS_SINGLE_SKU=ait.0000015595.6163cacf.75c6619a7e.5846691411
TOSS_MESSAGE_PASS_BUNDLE_SKU=ait.0000015595.ab4312ca.00ac5cae3b.5846703758

# Required in production: a random secret of at least 32 characters. Never expose to Vite.
SESSION_SECRET=
# Required for reviewing message reports and restoring a used pass.
ADMIN_API_TOKEN=
# Local development only; always disabled when NODE_ENV=production.
ALLOW_MOCK_LOGIN=false

# Temporary compatibility for the released, sessionless app.
# Set false AFTER the session-enabled Toss build is released (approval alone is not release).
ALLOW_LEGACY_API=true

# Reuse the existing Toss login mTLS certificate configuration:
# TOSS_CLIENT_CERT_BASE64=
# TOSS_CLIENT_KEY_BASE64=
# or TOSS_CLIENT_CERT_PATH= / TOSS_CLIENT_KEY_PATH= (relative to backend)

# Analytics admin password; required for /admin.html data APIs. No default password.
DASHBOARD_SECRET=
